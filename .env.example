# Database - Local PostgreSQL (change for production)
DATABASE_URL=postgresql://medcare:medcare@localhost:5432/medcare

# App
NODE_ENV=development
PORT=5000
SESSION_SECRET=change_this_to_a_random_secret

# Gemini AI - Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Email (Gmail) - Optional, app works without it
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Twilio SMS - Optional, app works without it
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase - Optional, app works without it
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
